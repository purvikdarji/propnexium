DB_ROOT_PASSWORD=your_root_password
DB_NAME=propnexium
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
BASE_URL=http://localhost:8080
ADMIN_EMAIL=admin@propnexium.com

# ─── Apache Kafka ────────────────────────────────────────────────────────────
# For local Docker: kafka:9092 (internal) or localhost:29092 (host)
# For managed Kafka (Confluent Cloud / AWS MSK): replace with cluster endpoint
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Per-topic Kafka feature flags
# Set to 'false' to fall back to the legacy @Async direct-call path for that flow
KAFKA_TOPICS_USER_REGISTERED_ENABLED=true
KAFKA_TOPICS_PROPERTY_SUBMITTED_ENABLED=true
KAFKA_TOPICS_PROPERTY_STATUS_CHANGED_ENABLED=true
KAFKA_TOPICS_BOOKING_CREATED_ENABLED=true
KAFKA_TOPICS_BOOKING_STATUS_CHANGED_ENABLED=true
KAFKA_TOPICS_INQUIRY_REPLIED_ENABLED=true
